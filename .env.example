# Copy to .env.local; load explicitly into the server environment.
HOST=127.0.0.1
PORT=4310
# Required if HOST is not loopback; use a randomly generated 32+ byte secret.
OPENGROKBOT_TOKEN=
# Set to 1 only when TLS is terminated by a trusted reverse proxy.
OPENGROKBOT_COOKIE_SECURE=0
# For a private Tailscale Serve / HTTPS reverse proxy on loopback, provide its exact public Host.
# Setting this also requires OPENGROKBOT_TOKEN.
OPENGROKBOT_ALLOWED_HOSTS=
# Optional AWS region; set AWS_PROFILE or use per-provider awsProfile in the UI.
AWS_REGION=us-east-1
AWS_PROFILE=
